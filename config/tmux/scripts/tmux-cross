#!/usr/bin/env bash

session="cross-adventures"
dir="/mnt/HD/godot-projects/$session/"


if ! tmux has-session -t "$session" 2>/dev/null; then
    tmux new-session -d -s "$session" -c "$dir"

    tmux send-keys -t "$session" "nvim ." C-m

    tmux new-window -t "$session" -c "$dir"
    tmux new-window -t "$session" -c "$dir"
    tmux new-window -t "$session" -c "$dir"
fi

tmux send-keys -t "$session:3" "godot -e" C-m

tmux send-keys -t "$session:2" "$HOME/.dotfiles/config/tmux/scripts/wait-godot.sh" C-m

tmux send-keys -t "$session:4" "opencode" C-m

tmux select-window -t "$session:1"
tmux attach -t "$session"

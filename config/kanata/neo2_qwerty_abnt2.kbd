;; Compose sequences: common and official examples; this is not the complete Neo database.
(defseq
  c001-ae (a e)
  c002-ae (S-a S-e)
  c003-oe (o e)
  c004-oe (S-o S-e)
  c005-ss (s s)
  c006-ss (S-s S-s)
  c007-th (t h)
  c008-th (S-t S-h)
  c009-dh (d h)
  c010-dh (S-d S-h)
  c011-comma-c (, c)
  c012-comma-c (, S-c)
  c013-t1-super7 (grv 7)
  c014-quote-a (S-' a)
  c015-quote-a (S-' S-a)
  c016-quote-e (S-' e)
  c017-quote-e (S-' S-e)
  c018-quote-i (S-' i)
  c019-quote-i (S-' S-i)
  c020-quote-o (S-' o)
  c021-quote-o (S-' S-o)
  c022-quote-u (S-' u)
  c023-quote-u (S-' S-u)
  c024-quote-y (S-' y)
  c025-quote-y (S-' S-y)
  c026-circ-a (grv a)
  c027-circ-a (grv S-a)
  c028-circ-e (grv e)
  c029-circ-e (grv S-e)
  c030-circ-i (grv i)
  c031-circ-i (grv S-i)
  c032-circ-o (grv o)
  c033-circ-o (grv S-o)
  c034-circ-u (grv u)
  c035-circ-u (grv S-u)
  c036-tilde-a (S-] a)
  c037-tilde-a (S-] S-a)
  c038-tilde-n (S-] n)
  c039-tilde-n (S-] S-n)
  c040-tilde-o (S-] o)
  c041-tilde-o (S-] S-o)
  c042-grave-a (= a)
  c043-grave-a (= S-a)
  c044-grave-e (= e)
  c045-grave-e (= S-e)
  c046-grave-i (= i)
  c047-grave-i (= S-i)
  c048-grave-o (= o)
  c049-grave-o (= S-o)
  c050-grave-u (= u)
  c051-grave-u (= S-u)
  c052-heart (S-, 3)
  c053-right-arrow (- S-.)
  c054-left-arrow (S-, -)
  c055-ellipsis (. . .)
  c056-em-dash (- - -)
  c057-half (1 2)
  c058-quarter (1 4)
  c059-three-quarters (3 4)
  c060-copyright (c o)
  c061-registered (r o)
  c062-trademark (t m)
  c063-degree (o o)
  c064-ohm (o m)
)
